# Local
VITE_API_URL=http://localhost:8787

# Comma-separated emails that can use admin test tools (wave skip) in production.
# In local Vite DEV, skip tools are available without this.
# VITE_ADMIN_EMAILS=you@example.com

# Google Sign-In (same Web client ID as API GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Contact email shown on Privacy / Terms pages (optional)
# VITE_CONTACT_EMAIL=you@example.com

# Production (Vercel project env) — set to your Render service URL, no trailing slash:
# VITE_API_URL=https://ramseys-arcade-api.onrender.com
# VITE_GOOGLE_CLIENT_ID=...
# VITE_ADMIN_EMAILS=you@example.com
